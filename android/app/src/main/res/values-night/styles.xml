<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Foreman" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#CBB4FF</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.Foreman.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/foreman_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Foreman</item>
        <item name="isLightTheme">false</item>
    </style>
</resources>
